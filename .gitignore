###############################################################################
# Sensitive / credential files — NEVER commit
###############################################################################

# Agent runtime configs: data/agents/<username>/<name>.yaml embeds real cookies
# and tokens of the platforms under test (e.g. JD sdtoken). Only keep the
# directory placeholder.
data/agents/*/
!data/agents/.gitkeep

