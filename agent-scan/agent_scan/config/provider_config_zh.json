{
  "http": {
    "name": "HTTP接口",
    "icon": "/images/agents-icon/http.webp",
    "description": "配置HTTP端点以发送请求",
    "fields": [
      {
        "field": "label",
        "label": "Agent名称",
        "type": "text",
        "required": true,
        "placeholder": "为此Agent输入自定义名称（支持英文及数字）",
        "description": "此Agent的描述名称"
      },
      {
        "field": "url",
        "label": "URL",
        "type": "text",
        "required": true,
        "placeholder": "https://api.example.com/chat",
        "description": "要发送请求的HTTP端点URL"
      },
      {
        "field": "method",
        "label": "HTTP方法",
        "type": "select",
        "required": true,
        "options": [
          {
            "label": "POST",
            "value": "POST"
          },
          {
            "label": "GET",
            "value": "GET"
          },
          {
            "label": "PUT",
            "value": "PUT"
          },
          {
            "label": "PATCH",
            "value": "PATCH"
          },
          {
            "label": "DELETE",
            "value": "DELETE"
          }
        ],
        "defaultValue": "POST",
        "description": "HTTP请求方法"
      },
      {
        "field": "headers",
        "label": "请求头",
        "type": "json",
        "required": false,
        "placeholder": "{\n  \"Content-Type\": \"application/json\"\n}",
        "defaultValue": "{\n  \"Content-Type\": \"application/json\"\n}",
        "rows": 4,
        "description": "JSON格式的HTTP请求头"
      },
      {
        "field": "body",
        "label": "请求体",
        "type": "textarea",
        "required": false,
        "placeholder": "{\n  \"message\": \"{{prompt}}\"\n}",
        "defaultValue": "{\n  \"message\": \"{{prompt}}\"\n}",
        "rows": 6,
        "description": "请求体模板。使用 {{prompt}} 作为测试输入的占位符"
      },
      {
        "field": "transform_response",
        "label": "响应解析器",
        "type": "text",
        "required": false,
        "placeholder": "json.choices[0].message.content",
        "description": "用于提取响应的JSONPath（可选）"
      },
      {
        "field": "timeout_ms",
        "label": "超时时间（毫秒）",
        "type": "number",
        "required": false,
        "min": 1000,
        "max": 300000,
        "step": 1000,
        "defaultValue": 30000,
        "description": "请求超时时间（毫秒）"
      }
    ]
  },
  "dify": {
    "name": "Dify AI",
    "icon": "/images/agents-icon/dify.webp",
    "description": "配置Dify AI平台",
    "fields": [
      {
        "field": "label",
        "label": "Agent名称",
        "type": "text",
        "required": true,
        "placeholder": "为此Agent输入自定义名称（支持英文及数字）",
        "description": "此Agent的描述名称"
      },
      {
        "field": "extra.dify_type",
        "label": "Dify端点类型",
        "type": "select",
        "required": false,
        "options": [
          {
            "label": "聊天消息",
            "value": "chat"
          },
          {
            "label": "工作流",
            "value": "workflow"
          }
        ],
        "defaultValue": "chat",
        "description": "聊天消息用于对话应用，工作流用于工作流执行"
      },
      {
        "field": "apiBaseUrl",
        "label": "API基础URL",
        "type": "text",
        "required": false,
        "placeholder": "https://api.dify.ai/v1",
        "description": "Dify API基础URL。留空使用默认值"
      },
      {
        "field": "apiKey",
        "label": "API-Key",
        "type": "password",
        "required": true,
        "placeholder": "app-xxxx",
        "description": "Dify API-Key"
      },
      {
        "field": "extra.user",
        "label": "用户ID",
        "type": "text",
        "required": false,
        "defaultValue": "agent-user",
        "description": "对话的用户标识符"
      },
      {
        "field": "extra.conversation_id",
        "label": "对话ID",
        "type": "text",
        "required": false,
        "placeholder": "留空开始新对话",
        "description": "留空开始新对话，或提供现有对话ID"
      },
      {
        "field": "extra.inputs",
        "label": "自定义输入",
        "type": "json",
        "required": false,
        "placeholder": "{}",
        "defaultValue": "{}",
        "rows": 4,
        "description": "将传递给Dify应用/工作流的自定义输入（JSON格式）"
      },
      {
        "field": "timeout_ms",
        "label": "超时时间（毫秒）",
        "type": "number",
        "required": false,
        "min": 1000,
        "max": 300000,
        "step": 1000,
        "defaultValue": 60000,
        "description": "请求超时时间（毫秒）"
      }
    ]
  },
  "coze": {
    "name": "Coze AI",
    "icon": "/images/agents-icon/coze.png",
    "description": "配置Coze AI机器人平台",
    "fields": [
      {
        "field": "label",
        "label": "Agent名称",
        "type": "text",
        "required": true,
        "placeholder": "为此Agent输入自定义名称（支持英文及数字）",
        "description": "此Agent的描述名称"
      },
      {
        "field": "extra.coze_region",
        "label": "Coze区域",
        "type": "select",
        "required": false,
        "options": [
          {
            "label": "中国 (api.coze.cn)",
            "value": "coze-cn"
          },
          {
            "label": "国际 (api.coze.com)",
            "value": "coze-com"
          }
        ],
        "defaultValue": "coze-cn",
        "description": "选择Coze API区域"
      },
      {
        "field": "extra.bot_id",
        "label": "Bot ID",
        "type": "text",
        "required": true,
        "placeholder": "输入您的Coze Bot ID",
        "description": "必填。来自Coze平台的Bot ID"
      },
      {
        "field": "apiBaseUrl",
        "label": "API基础URL",
        "type": "text",
        "required": false,
        "placeholder": "https://api.coze.cn",
        "description": "Coze API基础URL。留空根据区域使用默认值"
      },
      {
        "field": "apiKey",
        "label": "API-Key",
        "type": "password",
        "required": true,
        "placeholder": "pat_xxxx",
        "description": "Coze API-Key"
      },
      {
        "field": "extra.user_id",
        "label": "用户ID",
        "type": "text",
        "required": false,
        "defaultValue": "agent-user",
        "description": "对话的用户标识符"
      },
      {
        "field": "extra.conversation_id",
        "label": "对话ID",
        "type": "text",
        "required": false,
        "placeholder": "留空开始新对话",
        "description": "留空开始新对话，或提供现有对话ID"
      },
      {
        "field": "timeout_ms",
        "label": "超时时间（毫秒）",
        "type": "number",
        "required": false,
        "min": 1000,
        "max": 300000,
        "step": 1000,
        "defaultValue": 120000,
        "description": "请求超时时间（毫秒，默认：120000ms = 2分钟）"
      }
    ]
  },
  "sse": {
    "name": "SSE 大模型 API",
    "icon": "/images/agents-icon/http.webp",
    "description": "配置 SSE 流式架构的大模型 API（OpenAI 兼容流式接口 / 自定义 SSE 网关）",
    "fields": [
      {
        "field": "label",
        "label": "Agent名称",
        "type": "text",
        "required": true,
        "placeholder": "为此Agent输入自定义名称（支持英文及数字）",
        "description": "此Agent的描述名称"
      },
      {
        "field": "url",
        "label": "SSE 接口地址",
        "type": "text",
        "required": true,
        "placeholder": "https://api.example.com/v1/chat/completions",
        "description": "SSE 流式接口完整 URL（OpenAI 兼容通常为 /v1/chat/completions）"
      },
      {
        "field": "model",
        "label": "模型名称",
        "type": "text",
        "required": false,
        "placeholder": "gpt-4o-mini / deepseek-chat 等",
        "description": "请求体 model 字段使用的模型名；留空则使用请求体模板中的 model"
      },
      {
        "field": "apiKey",
        "label": "API Key",
        "type": "password",
        "required": false,
        "placeholder": "sk-...",
        "description": "鉴权密钥，将以 Bearer <key> 注入 Authorization 头"
      },
      {
        "field": "headers",
        "label": "自定义请求头",
        "type": "json",
        "required": false,
        "placeholder": "{\n  \"X-Custom\": \"value\"\n}",
        "rows": 3,
        "description": "附加 HTTP 请求头（Authorization 由 API Key 自动生成，无需重复配置）"
      },
      {
        "field": "body",
        "label": "请求体模板",
        "type": "textarea",
        "required": false,
        "rows": 6,
        "placeholder": "{\n  \"model\": \"your-model\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"{{prompt}}\"}]\n}",
        "description": "JSON 请求体模板，{{prompt}} 为攻击提示词占位符；未显式配置 stream 字段时自动启用流式"
      },
      {
        "field": "transform_response",
        "label": "响应提取路径",
        "type": "text",
        "required": false,
        "placeholder": "留空即可 — SSE 流会自动拼接为完整回答",
        "description": "高级：从响应 JSON 提取回答的路径（如 choices.0.message.content）。SSE 流默认自动聚合，无需配置"
      },
      {
        "field": "timeout_ms",
        "label": "超时（毫秒）",
        "type": "text",
        "required": false,
        "placeholder": "300000",
        "description": "单个数据块之间的最长等待时间，长思考模型建议调大"
      }
    ]
  },
  "common": {
    "name": "通用配置",
    "description": "所有provider类型的通用配置选项",
    "fields": [
      {
        "field": "delay",
        "label": "延迟（毫秒）",
        "type": "number",
        "required": false,
        "min": 0,
        "max": 60000,
        "step": 100,
        "defaultValue": 0,
        "description": "请求之间的延迟时间（毫秒），用于模拟真实用户"
      }
    ]
  }
}